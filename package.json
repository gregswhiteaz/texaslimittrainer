{
  "name": "tlh-trainer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:slow": "TLH_SLOW_TESTS=1 vitest run tests/playtest/throughput.acceptance.test.ts",
    "e2e": "playwright test",
    "e2e:slow": "TLH_SLOW_TESTS=1 playwright test e2e/responsive-table.spec.ts",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "playtest": "node --import ./tools/playtest/resolve-ts.js tools/playtest/main.ts",
    "playtest:million": "node --import ./tools/playtest/resolve-ts.js tools/playtest/million.ts",
    "chart:print": "node --import ./tools/playtest/resolve-ts.js tools/chart-print/main.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
